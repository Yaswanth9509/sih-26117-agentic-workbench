# =============================================================================
# MRPL Agentic Workbench - Environment Configuration
# Copy to .env and fill in values:  cp .env.example .env
# .env is gitignored. NEVER commit real keys.
# =============================================================================

# ── LLM PROVIDER SELECTION ───────────────────────────────────────────────────
# auto        = probe ollama -> gemini -> groq -> rule-based, use first available
# ollama      = local Mistral-7B, fully offline (target production stack)
# gemini      = Google Gemini REST API (cloud)
# groq        = Groq API, Llama-3 (cloud)
# rule-based  = deterministic engine, zero network calls. Always works.
LLM_PROVIDER=auto

# ── LLM: ollama (local Mistral-7B - the sovereign / on-premise path) ─────────
# Install with: bash scripts/setup_llm.sh
# Use 127.0.0.1, not localhost: localhost resolves ::1 first on Windows,
# which stalls every probe ~2s before falling back to IPv4.
# NOTE: this value is for running the app directly on the host. It has NO
# effect inside docker-compose - that path hardcodes host.docker.internal
# in docker-compose.yml on purpose, since 127.0.0.1 inside a container means
# the container itself, not the host where ollama actually runs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
# Measured on an RTX 4060 with the model warm in VRAM: a full reasoning call
# takes ~7.4s. CPU-only inference is much slower and will routinely miss
# this, correctly degrading to rule-based instead of answering in time.
OLLAMA_TIMEOUT_SEC=12
OLLAMA_PROBE_TIMEOUT_SEC=1.0

# ── LLM: Google Gemini (cloud) ───────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
# Leave blank to disable this provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_TOKENS=800
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_SEC=5

# ── LLM: Groq (cloud) ────────────────────────────────────────────────────────
# Free key from https://console.groq.com
# Leave blank to disable this provider.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=600
GROQ_TEMPERATURE=0.3
GROQ_TIMEOUT_SEC=8

# Label written to the audit log when no LLM provider is reachable
FALLBACK_ENGINE=rule-based

# How long a provider result is trusted before /health probes it again.
PROVIDER_PROBE_TTL_SEC=30.0

# Circuit breaker: after this many consecutive failures, skip the provider
# entirely and serve rule-based instead of paying its timeout on every
# query. 0 disables the breaker.
LLM_FAILURE_THRESHOLD=2
# How long the circuit stays open before one retry (half-open) is allowed.
# Without this, a transient burst - e.g. many concurrent requests queued
# behind one local GPU - permanently disables that provider until the
# process restarts, even after it's idle again seconds later. 0 disables
# recovery (matches old behavior: circuit stays open forever).
CIRCUIT_COOLDOWN_SEC=20.0

# ── RETRIEVAL BACKEND ────────────────────────────────────────────────────────
# tfidf = scikit-learn TF-IDF (current MVP, ~30 MB, no model downloads)
# faiss = FAISS + sentence-transformers (target stack, see docs/MIGRATION.md)
VECTOR_BACKEND=tfidf
VECTOR_STORE_PATH=data/tfidf_index.pkl
VECTOR_SEARCH_TOP_K=5
TFIDF_MAX_FEATURES=5000
# Used by the faiss backend only, ignored by tfidf
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=MRPL Agentic Workbench
API_VERSION=1.0.0

# ── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# ── SECURITY ─────────────────────────────────────────────────────────────────
MAX_QUERY_LENGTH=2000
INPUT_VALIDATION_ENABLED=true

# ── TIMEOUTS (seconds) ───────────────────────────────────────────────────────
AGENT_TIMEOUT_SEC=8
# Separate, larger budget for the reasoning agent only - it's the one agent
# that may call a local GPU LLM (~7-8s for a full call on an RTX 4060 with
# the model warm; much slower / will not finish on CPU-only hardware).
REASONING_AGENT_TIMEOUT_SEC=15
WORKFLOW_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=35

# ── LOGGING & AUDIT ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_PATH=data/audit_logs/decisions.jsonl

# ── BUSINESS RULES ───────────────────────────────────────────────────────────
MAX_RECOMMENDATION_COST_INR=100000
MAX_DOWNTIME_HOURS=4.0
SAFETY_MARGIN_PERCENT=5.0

# ── DATA PATHS ───────────────────────────────────────────────────────────────
SAMPLE_DOCS_PATH=data/sample_docs
